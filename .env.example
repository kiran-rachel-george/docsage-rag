# LLM provider: groq (free tier), openrouter, deepseek, or cloudflare (Workers AI, free tier)
# For cloudflare: LLM_PROVIDER=cloudflare, CLOUDFLARE_API_TOKEN, CLOUDFLARE_ACCOUNT_ID,
#                 LLM_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
# For deepseek: LLM_PROVIDER=deepseek, DEEPSEEK_API_KEY=..., LLM_MODEL=deepseek-flash
LLM_PROVIDER=cloudflare
GROQ_API_KEY=
DEEPSEEK_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
LLM_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
JUDGE_PROVIDER=groq
JUDGE_MODEL=openai/gpt-oss-120b
# OPENROUTER_API_KEY=   # only if LLM_PROVIDER=openrouter (then LLM_MODEL e.g. openai/gpt-4o)
# LLM_PRICE_INPUT_PER_M=    # USD per 1M tokens, to price models Groq doesn't list
# LLM_PRICE_OUTPUT_PER_M=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_ENVIRONMENT=development   # production | staging | development
