# Secrets
.env
.env.*
!.env.example
.streamlit/secrets.toml

# Raw source PDFs (publicly available; link to originals instead of redistributing)
data/raw/*
!data/raw/.gitkeep

# Built indexes: only the heading-aware index ships (the hosted demo needs it, ~8 MB)
data/index/*
!data/index/.gitkeep
!data/index/heading/

# Eval scratch files
eval/results/.partial_*

# Python / tooling
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/

# Installed agent skill (tooling, not part of the app)
.claude/
skills-lock.json
